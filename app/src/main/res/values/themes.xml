<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#ffffff</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:colorAccent">@color/brand_blue_bright</item>
        <item name="android:colorControlHighlight">#242F6FED</item>
        <!-- 全局弹窗统一换成圆角白卡 + 加粗标题（WakeUp 观感的来源之一） -->
        <item name="android:alertDialogTheme">@style/AppDialog</item>
    </style>

    <style name="AppDialog" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:windowTitleStyle">@style/AppDialogTitle</item>
        <item name="android:colorAccent">@color/brand_blue_bright</item>
        <item name="android:buttonBarButtonStyle">@style/AppDialogButton</item>
    </style>

    <style name="AppDialogTitle">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">#1B1F27</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 弹窗按钮：大字、无全大写、加粗（WakeUp 的按钮是粗体中文） -->
    <style name="AppDialogButton" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/brand_blue_bright</item>
        <item name="android:minWidth">64dp</item>
    </style>

    <style name="BottomSheetAnimation">
        <item name="android:windowEnterAnimation">@anim/sheet_slide_up</item>
        <item name="android:windowExitAnimation">@anim/sheet_slide_down</item>
    </style>

    <style name="CalendarWeekday">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#4E5360</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CalendarDialog" parent="@style/AppDialog">
        <item name="android:windowMinWidthMinor">78%</item>
    </style>

    <!--
      「更多」页的行样式。
      抽成 style 而不是在每行重复一遍属性：这一页有 9 行，
      行高/内边距改一次就要改 9 处，很容易改漏导致行高不齐。
    -->

    <!-- 行容器：横向排列 + 点击水波纹（selectableItemBackground 自带反馈） -->
    <style name="MoreRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">15dp</item>
        <item name="android:paddingBottom">15dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- 行主标题 -->
    <style name="MoreRowTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- 行副标题（说明文字） -->
    <style name="MoreRowSub">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <!-- 行内链接文字（URL） -->
    <style name="MoreRowLink">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#64789A</item>
    </style>

    <!-- 通道徽标（通道1 / 通道2 …）：淡蓝底 + 蓝字，比主徽标弱一档 -->
    <style name="MoreChannel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#1B4D8F</item>
        <item name="android:background">@drawable/badge_channel</item>
    </style>

    <!-- 蓝色徽标 -->
    <style name="MoreBadge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:background">@drawable/badge_blue</item>
    </style>

    <!-- 灰色徽标（次要状态，如「已有课表」） -->
    <style name="MoreBadgeGrey">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">#7b8494</item>
        <item name="android:background">@drawable/badge_grey</item>
    </style>

    <!-- 行右侧箭头 -->
    <style name="MoreArrow">
        <item name="android:layout_width">16dp</item>
        <item name="android:layout_height">16dp</item>
        <item name="android:background">@drawable/ic_more_arrow</item>
    </style>

    <!-- 行与行之间的分隔线（左右缩进 14dp，贴齐文字） -->
    <style name="MoreDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:background">#F2F3F6</item>
    </style>

    <!-- 课表设置页的分组小标题 -->
    <style name="MoreSectionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:textColor">#7D8798</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 「调课」面板里选日期的行（WakeUp 风的标签 + 值两级排版） -->
    <style name="AdjDateRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="AdjDateLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:textColor">#8B92A3</item>
    </style>

    <style name="AdjDateValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#1B4D8F</item>
    </style>

    <!--
      课表设置页的「标签 …… 值」行：左边是设置项名，右边是当前值或箭头。
      抽成 style 与「更多」页同理 —— 行数多，散写容易行高不齐。
    -->
    <style name="SsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="SsRowTitle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#222222</item>
    </style>

    <style name="SsRowValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#6c7686</item>
    </style>

    <!--
      课表设置面板里的四宫格单元（上课时间 / 课表设置 / 已添加课程 / 常见问题）。
      淡蓝底 + 圆角，视觉上比卡片轻一档：它们是「入口」，不是「内容」。
    -->
    <style name="SchedGridCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:background">@drawable/grid_cell_bg</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:textColor">#33405C</item>
    </style>
</resources>
