<?xml version="1.0" encoding="utf-8"?>
<!--
  扁平化按钮底板 · 蓝（主操作：刷新课表 / 查空教室）
  单层淡蓝底 + 细描边，无投影、无高光，和页面卡片同一个视觉层级。
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#331B4D8F">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="9dp" />
            <solid android:color="#EAF1FB" />
            <stroke android:width="1dp" android:color="#C7D9F2" />
        </shape>
    </item>
</ripple>
