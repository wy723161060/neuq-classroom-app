<?xml version="1.0" encoding="utf-8"?>
<!--
  拟物化按钮底板 · 灰（次要操作：返回教务 / 重新导入）
  与蓝色版同构，只是换成中性灰，视觉上退到后面。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#C3C8D0" />
        </shape>
    </item>

    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="270"
                android:startColor="#FFFFFF"
                android:centerColor="#F4F5F8"
                android:endColor="#E4E7EC"
                android:type="linear" />
            <stroke android:width="1dp" android:color="#C3C8D0" />
        </shape>
    </item>

    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="270"
                android:startColor="#55FFFFFF"
                android:centerColor="#10FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
