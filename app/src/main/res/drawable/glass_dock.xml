<?xml version="1.0" encoding="utf-8"?>
<!--
  底部导航的「悬浮玻璃 Dock」。

  三处细节决定它像不像玻璃：
    1. 底色只给 78% 白 —— 页面背景/自定义背景图能透上来；
    2. 顶部高光 + 四周发丝描边，边缘才有「厚度」；
    3. 配合布局里的 margins + elevation，让它浮在页面之上，而不是贴在底边。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#BFFFFFFF" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_border" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/glass_highlight"
                android:centerColor="#14FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
