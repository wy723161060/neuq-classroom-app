<?xml version="1.0" encoding="utf-8"?>
<!--
  全局卡片材质：半透明玻璃。

  只做一层 shape（不再叠高光层）是有意为之：
  「课表设置 → 主题 → 卡片色」会通过 applyThemeToView 重染 GradientDrawable，
  多层 LayerDrawable 会被跳过，那项设置就失效了。单层 + 保留 alpha 的写法
  既能透出背景，又能继续跟随用户选的卡片色。

  圆角从 14dp 提到 18dp，配合半透明更柔和。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="18dp" />
    <solid android:color="@color/glass_fill" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_border" />
</shape>
