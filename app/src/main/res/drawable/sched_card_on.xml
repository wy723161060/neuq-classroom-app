<?xml version="1.0" encoding="utf-8"?>
<!--
  课表卡片（当前选中）：淡蓝底 + 1.5dp 蓝色描边。

  选中态用「描边加粗 + 底色变化」两重信号，而不是只加一个 ✓ 徽标 ——
  参考截图里选中的那张表就是蓝框，扫一眼就能认出在用哪张。
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#201B4D8F">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F1F6FD" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1.5dp"
                android:color="#2F6FED" />
        </shape>
    </item>
</ripple>
