<?xml version="1.0" encoding="utf-8"?>
<!--
  课表设置 · 底部卡片式抽屉（课表页顶栏的 ⋮ 打开）

  参考用户给的那张课表截图组织信息：
    周数（滑杆 + 当前周） → 课表列表（卡片，选中的那张蓝框 + ✓） → 添加课表

  为什么周数调节要放进这个面板：课表页那张 HTML 周次条上已经有「上周 / 下周 / 本周」，
  但那是逐周点；一次要跳到第 14 周要点十几下。滑杆是补这一块，不是替代。

  抽屉同样用系统 Dialog 实现（本项目零第三方依赖）。外层 46dp 的把手区是必需的：
  抽屉的圆角是 20dp，内容若从最顶端开始排，会在圆角处露出直角内容。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/sheet_bg"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="18dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/sheet_handle" />

            <!--
              不放「课表设置」标题（用户要求）：把手本身就是「这是个抽屉」的信号，
              面板内容（周数/课表/宫格）也自解释，标题行属于占空间不提供信息。
              关闭走「点抽屉外部」或返回键，不单独放 ✕。
            -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <!--
              不放「课表设置」标题（用户要求）：把手本身就是「这是个抽屉」的信号，
              面板内容（周数/课表/宫格）也自解释，标题行属于占空间不提供信息。
              关闭走「点抽屉外部」或返回键，不单独放 ✕。
            -->

            <!-- ══════════ 周数 ══════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:background="@drawable/cache_card_bg"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="周数"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        android:textColor="#222222" />

                    <!-- 「回到本周」是个文字按钮：只在翻过周之后才出现，
                         一直挂着会让面板看起来有个用不上的动作 -->
                    <TextView
                        android:id="@+id/schedNow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="10dp"
                        android:paddingEnd="4dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:text="回到本周"
                        android:textSize="12sp"
                        android:textColor="#1B4D8F"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal"
                    android:gravity="bottom">

                    <TextView
                        android:id="@+id/schedWeekText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="第 1 周"
                        android:textSize="21sp"
                        android:textStyle="bold"
                        android:textColor="#1B4D8F" />

                    <TextView
                        android:id="@+id/schedWeekSub"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:layout_marginBottom="3dp"
                        android:text="— 起"
                        android:textSize="12sp"
                        android:textColor="#9AA2B4" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/schedSeek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="20"
                    android:progress="1"
                    android:progressTint="#1B4D8F"
                    android:progressBackgroundTint="#E3E7EE"
                    android:thumbTint="#1B4D8F" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="左右拖动可快速跳到任意一周（面板关闭后课表停在所选周）"
                    android:textSize="11sp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="#A8AFBD" />
            </LinearLayout>

            <!-- ══════════ 课表列表 ══════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="我的课表"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1B1F27" />

                <TextView
                    android:id="@+id/schedCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="共 1 张"
                    android:textSize="12sp"
                    android:textColor="#9AA2B4" />
            </LinearLayout>

            <!-- 卡片在这里动态插入（张数不固定，用代码 addView） -->
            <LinearLayout
                android:id="@+id/schedList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <!--
              四宫格入口（仿照参考截图的样式）：课表相关的次级功能收在这里，
              面板本体只留最高频的「调周次 / 切课表 / 调课 / 添加」。
                上课时间   —— 查看每节课的起止时间
                课表设置   —— 整页设置：开学日期 / 外观 / 重命名 / 删除
                已添加课程 —— 课程卡片墙，可改可删
                常见问题   —— 使用说明
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/gridTime"
                    style="@style/SchedGridCell"
                    android:text="上课时间" />

                <TextView
                    android:id="@+id/gridSettings"
                    style="@style/SchedGridCell"
                    android:layout_marginStart="10dp"
                    android:text="课表设置" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/gridCourses"
                    style="@style/SchedGridCell"
                    android:text="已添加课程" />

                <TextView
                    android:id="@+id/gridFaq"
                    style="@style/SchedGridCell"
                    android:layout_marginStart="10dp"
                    android:text="常见问题" />
            </LinearLayout>

            <!--
              两个动作并排：
                调课     —— 老师临时挪课 / 换教室 / 本周停课，做本地调整（描边款）
                添加课表 —— 新建一张空白课表（实心蓝，本面板唯一的主行动）
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/schedAdjust"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/btn_outline_blue"
                    android:baselineAligned="false"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="调课"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_skeu_swap"
                        android:tint="#1B4D8F" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:includeFontPadding="false"
                        android:text="调课"
                        android:textColor="#1B4D8F"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/schedAdd"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/cache_btn_primary"
                    android:baselineAligned="false"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="添加课表"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_skeu_add"
                        android:tint="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:includeFontPadding="false"
                        android:text="添加课表"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="多张课表分别缓存在本机，可随时切换；调课只改本机显示，教务系统不受影响"
                android:textSize="11sp"
                android:textColor="#A8AFBD" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
