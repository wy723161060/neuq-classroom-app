<?xml version="1.0" encoding="utf-8"?>
<!--
  手动添加课程对话框：名称 / 教师 / 教室 / 星期 / 起止节次。
  不选周次 = 全周生效（考试、补课这类一次性安排可以在加完之后用「调课」的停课控制）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="8dp">

    <EditText
        android:id="@+id/caName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="课程名"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/caTeacher"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="教师（可留空）"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/caRoom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="教室（可留空）"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="星期"
            android:textSize="13sp"
            android:textColor="#55617A" />

        <Spinner
            android:id="@+id/caDay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:spinnerMode="dialog"
            android:popupBackground="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="节次"
            android:textSize="13sp"
            android:textColor="#55617A" />

        <Spinner
            android:id="@+id/caStart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:spinnerMode="dialog"
            android:popupBackground="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:text="至"
            android:textSize="13sp"
            android:textColor="#9AA2B4" />

        <Spinner
            android:id="@+id/caEnd"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:spinnerMode="dialog"
            android:popupBackground="#FFFFFF" />
    </LinearLayout>

    <!-- 周次：全周 / 固定范围 / 单双周 / 自定义（WakeUp 式手动加课的关键能力） -->
    <LinearLayout
        android:id="@+id/caWeeksPick"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/cache_card_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="周次"
            android:src="@drawable/ic_course_calendar" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="周次"
            android:textColor="#667085"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/caWeeksValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:text="全周"
            android:textColor="@color/brand_blue_bright"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
