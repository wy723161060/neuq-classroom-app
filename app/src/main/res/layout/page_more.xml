<?xml version="1.0" encoding="utf-8"?>
<!--
  「更多」页布局 · 原生实现

  用原生 ScrollView + 卡片而不是 WebView 渲染 HTML：
  WebView 方案虽然写起来快，但每一页都要跟一遍主题、点击反馈、行高，
  而且和底部 Tab 的原生质感不一致。设置类页面元素固定、不需要动态排版，
  用原生控件反而更少代码、更顺滑。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/moreScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f5f6f8"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="22dp">

        <!-- ══════════ 教务 ══════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="6dp"
            android:text="教务"
            android:textSize="12sp"
            android:textColor="#8b92a3"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:id="@+id/rowLogin"
                style="@style/MoreRow">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/MoreRowTitle"
                        android:text="教务处登录" />

                    <TextView
                        style="@style/MoreRowSub"
                        android:text="登录统一身份认证，会话保留在本机" />
                </LinearLayout>

                <TextView
                    android:id="@+id/badgeLogin"
                    style="@style/MoreBadge"
                    android:text="必做" />

                <TextView style="@style/MoreArrow" />
            </LinearLayout>

            <View style="@style/MoreDivider" />

            <!--
              记住密码并自动登录：默认关闭，用户主动打开才生效。
              把开关放在「教务处登录」正下方 —— 两件事本来就是一个流程：
              第一次手动登录时顺便记住，之后的会话过期就不用再输了。
            -->
            <LinearLayout
                android:id="@+id/rowAutoLogin"
                style="@style/MoreRow">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/MoreRowTitle"
                        android:text="记住密码并自动登录" />

                    <TextView
                        android:id="@+id/subAutoLogin"
                        style="@style/MoreRowSub"
                        android:text="未开启 · 开启后登录一次即可自动登录" />
                </LinearLayout>

                <Switch
                    android:id="@+id/swAutoLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="@color/sw_thumb"
                    android:trackTint="@color/sw_track" />
            </LinearLayout>
        </LinearLayout>

        <!-- ══════════ 存储 ══════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="6dp"
            android:text="存储"
            android:textSize="12sp"
            android:textColor="#8b92a3"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:id="@+id/rowCache"
                style="@style/MoreRow">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/MoreRowTitle"
                        android:text="缓存管理" />

                    <TextView
                        android:id="@+id/subCache"
                        style="@style/MoreRowSub"
                        android:text="课表 — ｜ 空教室 —" />

                    <!-- 合计行：与上一行留 3dp，避免两行小字糊成一块 -->
                    <TextView
                        android:id="@+id/subCacheTotal"
                        style="@style/MoreRowSub"
                        android:layout_marginTop="3dp"
                        android:text="" />
                </LinearLayout>

                <TextView style="@style/MoreArrow" />
            </LinearLayout>
        </LinearLayout>

        <!-- ══════════ 空教室表网页 ══════════
             网页版总表入口（每小时自动更新）。v3.8.0 起只保留通道 2：
             通道 1 的站点已停更，双通道的容灾价值不再成立。 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="6dp"
            android:text="空教室表网页"
            android:textSize="12sp"
            android:textColor="#8b92a3"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="11dp"
                android:paddingBottom="11dp"
                android:text="在应用内打开网页版，查看全校空闲教室总表（每小时自动更新）。点击任一行即可打开。"
                android:textSize="11.5sp"
                android:lineSpacingExtra="2dp"
                android:textColor="#9aa2b4" />

            <View style="@style/MoreDivider" />

            <!-- 通道 2：上游仓库的网页版入口（v3.8.0 起通道 1 下线，只留此入口） -->
            <LinearLayout
                android:id="@+id/rowChannel2"
                style="@style/MoreRow">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/MoreRowTitle"
                        android:text="空闲教室总表（tsiao.io）" />

                    <TextView
                        style="@style/MoreRowLink"
                        android:text="neuq.tsiao.io" />
                </LinearLayout>

                <TextView
                    style="@style/MoreChannel"
                    android:text="通道2" />

                <TextView style="@style/MoreArrow" />
            </LinearLayout>
        </LinearLayout>

        <!-- ══════════ 关于 ══════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="6dp"
            android:text="关于"
            android:textSize="12sp"
            android:textColor="#8b92a3"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:layout_marginBottom="10dp">

            <!-- 应用标识区 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="18dp"
                android:paddingBottom="12dp">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/ic_neuq_logo"
                    android:contentDescription="东北大学秦皇岛分校校徽" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="东秦课表 · 安卓 App"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#222222" />

                <TextView
                    android:id="@+id/tvVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="版本 —"
                    android:textSize="12sp"
                    android:textColor="#8b92a3" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="东北大学秦皇岛分校课表与空闲教室速查工具。内置浏览器打开学校教务系统，登录一次后即可导入课表、查询空教室；所有数据都在你的手机本地读取和缓存，不经过任何第三方服务器。"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="#6c7686" />
            </LinearLayout>

            <View style="@style/MoreDivider" />

            <LinearLayout
                android:id="@+id/rowAppRepo"
                style="@style/MoreRow">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/MoreRowTitle"
                        android:text="应用项目" />

                    <TextView
                        style="@style/MoreRowLink"
                        android:text="github.com/wy723161060/neuq-classroom-app" />
                </LinearLayout>

                <TextView style="@style/MoreArrow" />
            </LinearLayout>

            <View style="@style/MoreDivider" />

            <LinearLayout
                android:id="@+id/rowCopyDiag"
                style="@style/MoreRow">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/MoreRowTitle"
                        android:text="复制诊断信息" />

                    <TextView
                        style="@style/MoreRowSub"
                        android:text="版本、缓存状态等，反馈问题时一并提供" />
                </LinearLayout>

                <TextView style="@style/MoreArrow" />
            </LinearLayout>

            <View style="@style/MoreDivider" />

            <LinearLayout
                android:id="@+id/rowHowto"
                style="@style/MoreRow">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/MoreRowTitle"
                        android:text="使用说明" />

                    <TextView
                        style="@style/MoreRowSub"
                        android:text="怎么查空教室 / 导入课表 / 换学期" />
                </LinearLayout>

                <TextView style="@style/MoreArrow" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="非官方工具 · 数据取自教务系统实时查询\n请以教务系统实际结果为准"
            android:textSize="11sp"
            android:textColor="#a8afbd" />
    </LinearLayout>
</ScrollView>
