<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_bg"
    android:layout_marginStart="22dp"
    android:layout_marginEnd="22dp"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="16dp"
    android:paddingBottom="2dp">

    <TextView
        android:id="@+id/calendarCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="待选择日期"
        android:textColor="#596275"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/calendarSelected"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="2026年9月22日"
        android:textColor="#4E5360"
        android:textSize="25sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="7dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/calendarMonth"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="2026年9月"
            android:textColor="#4E5360"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/calendarPrev"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="上个月"
            android:padding="9dp"
            android:src="@drawable/ic_chevron_left"
            android:tint="#4E5360" />

        <ImageButton
            android:id="@+id/calendarNext"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="下个月"
            android:padding="9dp"
            android:src="@drawable/ic_chevron_right"
            android:tint="#4E5360" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView style="@style/CalendarWeekday" android:text="一" />
        <TextView style="@style/CalendarWeekday" android:text="二" />
        <TextView style="@style/CalendarWeekday" android:text="三" />
        <TextView style="@style/CalendarWeekday" android:text="四" />
        <TextView style="@style/CalendarWeekday" android:text="五" />
        <TextView style="@style/CalendarWeekday" android:text="六" />
        <TextView style="@style/CalendarWeekday" android:text="日" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/calendarGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="4dp" />
</LinearLayout>
