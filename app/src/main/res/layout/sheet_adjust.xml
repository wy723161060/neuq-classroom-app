<?xml version="1.0" encoding="utf-8"?>
<!--
  调课 · 底部卡片式抽屉

  流程刻意做成「一屏三段」，不做向导：
    ① 选哪节课（本周实际要上的课，已含之前的调课结果）
    ② 调到哪（星期 / 节次 / 教室）
    ③ 作用范围（就这一周 / 之后每周）
  用户改一次调课通常只关心这一次，所以默认选中「仅第 N 周」；
  要整学期改时间才去动「所有周」。

  底部再列出这张课表已有的调课记录，逐条可撤销 ——
  调课是「临时」的动作，用户最需要的是能方便地改回去。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/sheet_bg"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="18dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/sheet_handle" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 标题 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="调课"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#1B1F27" />

                    <TextView
                        android:id="@+id/adjWeekHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="第 1 周"
                        android:textSize="11.5sp"
                        android:textColor="#9AA2B4" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/adjClose"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="-6dp"
                    android:background="@drawable/btn_icon_flat"
                    android:src="@drawable/ic_skeu_close"
                    android:tint="#8B92A3"
                    android:scaleType="centerInside"
                    android:contentDescription="关闭" />
            </LinearLayout>

            <!-- ① 整天调课：节假日调休用，学校通知通常直接说日期 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="② 选择课程（本周实际课表）"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#8B92A3" />

            <Spinner
                android:id="@+id/adjCourse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/cache_card_bg"
                android:paddingStart="12dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:spinnerMode="dialog"
                android:popupBackground="#FFFFFF" />

            <TextView
                android:id="@+id/adjEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/cache_card_bg"
                android:gravity="center"
                android:paddingTop="18dp"
                android:paddingBottom="18dp"
                android:text="本周这张课表上没有课"
                android:textSize="12.5sp"
                android:textColor="#9AA2B4"
                android:visibility="gone" />

            <!-- ② 调到 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="③ 调到"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#8B92A3" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical"
                android:background="@drawable/cache_card_bg"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="星期"
                    android:textSize="12.5sp"
                    android:textColor="#55617A" />

                <Spinner
                    android:id="@+id/adjDay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:spinnerMode="dialog"
                    android:popupBackground="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="节次"
                    android:textSize="12.5sp"
                    android:textColor="#55617A" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Spinner
                        android:id="@+id/adjSeStart"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:spinnerMode="dialog"
                        android:popupBackground="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:text="至"
                        android:textSize="12.5sp"
                        android:textColor="#9AA2B4" />

                    <Spinner
                        android:id="@+id/adjSeEnd"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:spinnerMode="dialog"
                        android:popupBackground="#FFFFFF" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="教室"
                    android:textSize="12.5sp"
                    android:textColor="#55617A" />

                <EditText
                    android:id="@+id/adjRoom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="留空表示沿用原教室"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <!-- ③ 作用范围 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="④ 作用范围"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#8B92A3" />

            <RadioGroup
                android:id="@+id/adjScope"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/cache_card_bg"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <RadioButton
                    android:id="@+id/adjScopeWeek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="仅这一周"
                    android:textSize="13.5sp"
                    android:textColor="#222222" />

                <RadioButton
                    android:id="@+id/adjScopeAll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="之后每周都这样（整学期改时间用这个）"
                    android:textSize="13.5sp"
                    android:textColor="#222222" />
            </RadioGroup>

            <!-- 主行动 -->
            <TextView
                android:id="@+id/adjConfirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/cache_btn_primary"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="确认调课"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/adjCancelWeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/cache_btn_danger"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="停课（不排这节课）"
                android:textSize="13sp"
                android:textColor="#C0392B" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="① 整天调课（节假日调休）"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#8B92A3" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical"
                android:background="@drawable/cache_card_bg"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:id="@+id/adjDmSrcRow"
                    style="@style/AdjDateRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/AdjDateLabel"
                            android:text="把这一天的课全部调走" />

                        <TextView
                            android:id="@+id/adjDmSrcText"
                            style="@style/AdjDateValue"
                            android:text="点击选择日期" />
                    </LinearLayout>

                    <TextView style="@style/MoreArrow" />
                </LinearLayout>

                <View style="@style/MoreDivider" />

                <LinearLayout
                    android:id="@+id/adjDmDstRow"
                    style="@style/AdjDateRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/AdjDateLabel"
                            android:text="整体调到这一天" />

                        <TextView
                            android:id="@+id/adjDmDstText"
                            style="@style/AdjDateValue"
                            android:text="点击选择日期" />
                    </LinearLayout>

                    <TextView style="@style/MoreArrow" />
                </LinearLayout>

                <TextView
                    android:id="@+id/adjDmConfirm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/cache_btn_primary"
                    android:gravity="center"
                    android:paddingTop="11dp"
                    android:paddingBottom="11dp"
                    android:text="确认整天调课"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <TextView
                android:id="@+id/adjOpenSingle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/btn_outline_blue"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="单节调课"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1B4D8F" />

            <LinearLayout
                android:id="@+id/adjSingleSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

            <!-- 已有记录 -->
            <TextView
                android:id="@+id/adjListTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="已有的调课记录"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#8B92A3"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/adjList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="调课只改本机显示，不改教务系统；重新导入课表后记录仍然有效"
                android:textSize="11sp"
                android:textColor="#A8AFBD" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
