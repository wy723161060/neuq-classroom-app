<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/sheet_bg"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="18dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/sheet_handle" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="调课"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#1B1F27" />

                    <TextView
                        android:id="@+id/adjWeekHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="第 1 周"
                        android:textSize="11.5sp"
                        android:textColor="#9AA2B4" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/adjClose"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="-6dp"
                    android:background="@drawable/btn_icon_flat"
                    android:src="@drawable/ic_skeu_close"
                    android:tint="#8B92A3"
                    android:scaleType="centerInside"
                    android:contentDescription="关闭" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="整天调课（节假日调休）"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#8B92A3" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical"
                android:background="@drawable/cache_card_bg"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:id="@+id/adjDmSrcRow"
                    style="@style/AdjDateRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/AdjDateLabel"
                            android:text="把这一天的课全部调走" />

                        <TextView
                            android:id="@+id/adjDmSrcText"
                            style="@style/AdjDateValue"
                            android:text="点击选择日期" />
                    </LinearLayout>

                    <TextView style="@style/MoreArrow" />
                </LinearLayout>

                <View style="@style/MoreDivider" />

                <LinearLayout
                    android:id="@+id/adjDmDstRow"
                    style="@style/AdjDateRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/AdjDateLabel"
                            android:text="整体调到这一天" />

                        <TextView
                            android:id="@+id/adjDmDstText"
                            style="@style/AdjDateValue"
                            android:text="点击选择日期" />
                    </LinearLayout>

                    <TextView style="@style/MoreArrow" />
                </LinearLayout>

                <TextView
                    android:id="@+id/adjDmConfirm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/cache_btn_primary"
                    android:gravity="center"
                    android:paddingTop="11dp"
                    android:paddingBottom="11dp"
                    android:text="确认整天调课"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <TextView
                android:id="@+id/adjListTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="已有的调课记录"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#8B92A3"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/adjList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/adjOpenSingle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/btn_outline_blue"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="单节调课"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1B4D8F" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="调课只改本机显示，不改教务系统；重新导入课表后记录仍然有效"
                android:textSize="11sp"
                android:textColor="#A8AFBD" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
