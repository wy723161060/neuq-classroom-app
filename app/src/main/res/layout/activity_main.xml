<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#f5f6f8">

    <!--
      顶栏：左侧状态文字，右侧扁平化图标按钮（与页面卡片同层级，无立体投影）。
      按钮显隐由 MainActivity.applyUi(UiState) 一处统一控制。
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="10dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:background="#ffffff"
        android:elevation="2dp">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:text="教务系统"
            android:textSize="13sp"
            android:textColor="#555"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- 返回教务（次要） -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/btn_flat_grey"
            android:src="@drawable/ic_skeu_back"
            android:scaleType="centerInside"
            android:contentDescription="返回教务"
            android:visibility="gone" />

        <!-- 查空教室（主操作）：无底色纯图标，和刷新同一套观感 -->
        <ImageButton
            android:id="@+id/btnQuery"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/btn_icon_flat"
            android:src="@drawable/ic_skeu_search"
            android:scaleType="centerInside"
            android:contentDescription="查空教室" />

        <!--
          刷新（主操作）：空教室页刷新数据用。
          课表页顶栏已不放刷新按钮（导入入口在「更多 → 教务处登录」，
          空课表页内有引导入口），所以这个按钮现在只在空教室页出现。
        -->
        <ImageButton
            android:id="@+id/btnRefreshData"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/btn_icon_flat"
            android:src="@drawable/ic_skeu_refresh"
            android:scaleType="centerInside"
            android:contentDescription="刷新"
            android:visibility="gone" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/loginView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <WebView
            android:id="@+id/resultView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!--
          「更多」页：原生布局而不是 WebView。
          设置类页面元素固定、不涉及动态排版，原生控件点击反馈和行高都更自然，
          也省掉一层 HTML 生成与 CSS 维护。
        -->
        <include
            android:id="@+id/morePage"
            layout="@layout/page_more"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!--
          内嵌浏览器页：用来打开空闲教室总表网页。
          单独一个 WebView，不和教务那两个共用 —— 总表与教务是两套站点，
          共用一个 WebView 会让「上一次浏览的页面」在两个用途间串味，
          返回键该退网页还是退 App 也会变得说不清。
          结构是「标题栏 + 进度条 + WebView」，所以整块用 LinearLayout 包住。
        -->
        <LinearLayout
            android:id="@+id/webPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#ffffff"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/webBar"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="6dp"
                android:paddingEnd="10dp"
                android:background="#ffffff"
                android:elevation="2dp">

                <ImageButton
                    android:id="@+id/btnWebBack"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/btn_flat_grey"
                    android:src="@drawable/ic_skeu_back"
                    android:scaleType="centerInside"
                    android:contentDescription="返回" />

                <TextView
                    android:id="@+id/webUrlText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:maxLines="1"
                    android:ellipsize="middle"
                    android:textSize="12.5sp"
                    android:textColor="#6c7686"
                    android:text="" />

                <ImageButton
                    android:id="@+id/btnWebReload"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/btn_flat_blue"
                    android:src="@drawable/ic_skeu_refresh"
                    android:scaleType="centerInside"
                    android:contentDescription="刷新网页" />

                <ImageButton
                    android:id="@+id/btnWebOpenOuter"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/btn_flat_grey"
                    android:src="@drawable/ic_more_arrow"
                    android:scaleType="centerInside"
                    android:contentDescription="用外部浏览器打开" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/webProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="2.5dp"
                android:max="100" />

            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:background="#ffffff"
        android:elevation="6dp">

        <LinearLayout
            android:id="@+id/tabSchedule"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground">

            <View
                android:id="@+id/indSchedule"
                android:layout_width="26dp"
                android:layout_height="3dp"
                android:layout_marginBottom="5dp"
                android:background="#1B4D8F" />

            <TextView
                android:id="@+id/tvSchedule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="课表"
                android:textSize="13sp"
                android:textColor="#1B4D8F" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabClassroom"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground">

            <View
                android:id="@+id/indClassroom"
                android:layout_width="26dp"
                android:layout_height="3dp"
                android:layout_marginBottom="5dp"
                android:background="#1B4D8F"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/tvClassroom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="空教室"
                android:textSize="13sp"
                android:textColor="#9aa2b4" />
        </LinearLayout>

        <!--
          更多：最右侧。课表 / 空教室之外的设置类功能都收在这里
          （教务处登录、缓存管理、关于本应用…），以后加功能只往这一页塞，
          不用再往顶栏堆按钮。
        -->
        <LinearLayout
            android:id="@+id/tabMore"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground">

            <View
                android:id="@+id/indMore"
                android:layout_width="26dp"
                android:layout_height="3dp"
                android:layout_marginBottom="5dp"
                android:background="#1B4D8F"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/tvMore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="更多"
                android:textSize="13sp"
                android:textColor="#9aa2b4" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
