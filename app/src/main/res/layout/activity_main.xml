<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#f5f6f8">

    <!--
      顶栏：左侧状态文字，右侧拟物化图标按钮。
      按钮显隐由 MainActivity.applyUi(UiState) 一处统一控制。
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="10dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:background="#ffffff"
        android:elevation="2dp">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:text="教务系统"
            android:textSize="13sp"
            android:textColor="#555"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- 返回教务（次要） -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/btn_skeu_grey"
            android:src="@drawable/ic_skeu_back"
            android:scaleType="centerInside"
            android:contentDescription="返回教务"
            android:visibility="gone" />

        <!-- 查空教室（主操作） -->
        <ImageButton
            android:id="@+id/btnQuery"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/btn_skeu_blue"
            android:src="@drawable/ic_skeu_search"
            android:scaleType="centerInside"
            android:contentDescription="查空教室" />

        <!-- 刷新数据（主操作） -->
        <ImageButton
            android:id="@+id/btnRefreshData"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/btn_skeu_blue"
            android:src="@drawable/ic_skeu_refresh"
            android:scaleType="centerInside"
            android:contentDescription="刷新数据"
            android:visibility="gone" />

        <!-- 导入课表（主操作） -->
        <ImageButton
            android:id="@+id/btnImport"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/btn_skeu_blue"
            android:src="@drawable/ic_skeu_import"
            android:scaleType="centerInside"
            android:contentDescription="导入课表"
            android:visibility="gone" />

        <!-- 重新导入（次要） -->
        <ImageButton
            android:id="@+id/btnReimport"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/btn_skeu_grey"
            android:src="@drawable/ic_skeu_import"
            android:scaleType="centerInside"
            android:contentDescription="重新导入课表"
            android:visibility="gone" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/loginView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <WebView
            android:id="@+id/resultView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:background="#ffffff"
        android:elevation="6dp">

        <LinearLayout
            android:id="@+id/tabSchedule"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground">

            <View
                android:id="@+id/indSchedule"
                android:layout_width="26dp"
                android:layout_height="3dp"
                android:layout_marginBottom="5dp"
                android:background="#1B4D8F" />

            <TextView
                android:id="@+id/tvSchedule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="课表"
                android:textSize="13sp"
                android:textColor="#1B4D8F" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabClassroom"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground">

            <View
                android:id="@+id/indClassroom"
                android:layout_width="26dp"
                android:layout_height="3dp"
                android:layout_marginBottom="5dp"
                android:background="#1B4D8F"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/tvClassroom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="空教室"
                android:textSize="13sp"
                android:textColor="#9aa2b4" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
