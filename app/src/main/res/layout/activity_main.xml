<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#f5f6f8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="#ffffff"
        android:elevation="2dp">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="教务系统"
            android:textSize="13sp"
            android:textColor="#555"
            android:maxLines="2" />

        <Button
            android:id="@+id/btnQuery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="查空教室"
            android:textSize="13sp"
            android:minHeight="36dp" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="返回教务"
            android:textSize="13sp"
            android:minHeight="36dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnRefreshData"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="刷新数据"
            android:textSize="13sp"
            android:minHeight="36dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnImport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="导入课表"
            android:textSize="13sp"
            android:minHeight="36dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnReimport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="重新导入"
            android:textSize="13sp"
            android:minHeight="36dp"
            android:visibility="gone" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/loginView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <WebView
            android:id="@+id/resultView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:background="#ffffff"
        android:elevation="6dp">

        <LinearLayout
            android:id="@+id/tabSchedule"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground">

            <View
                android:id="@+id/indSchedule"
                android:layout_width="26dp"
                android:layout_height="3dp"
                android:layout_marginBottom="5dp"
                android:background="#1B4D8F" />

            <TextView
                android:id="@+id/tvSchedule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="课表"
                android:textSize="13sp"
                android:textColor="#1B4D8F" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabClassroom"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground">

            <View
                android:id="@+id/indClassroom"
                android:layout_width="26dp"
                android:layout_height="3dp"
                android:layout_marginBottom="5dp"
                android:background="#1B4D8F"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/tvClassroom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="空教室"
                android:textSize="13sp"
                android:textColor="#9aa2b4" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
