<?xml version="1.0" encoding="utf-8"?>
<!--
  编辑课程对话框（v3.8 WakeUp 化）。

  名称 / 教师 / 教室是「这门课」的属性；星期 / 节次 / 周次是「这一节课」的属性 ——
  从课程卡片的节次列表里点进来，改时间只影响选中的那一节，不影响同课名其他节次。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="8dp">

    <EditText
        android:id="@+id/ceName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="课程名"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/ceTeacher"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="教师（可留空）"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/ceRoom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="教室（可留空）"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:textSize="14sp" />

    <!-- 以下针对「这一节课」：改时间不会影响这门课的其他节次 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="星期"
            android:textSize="13sp"
            android:textColor="#55617A" />

        <Spinner
            android:id="@+id/ceDay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:spinnerMode="dialog"
            android:popupBackground="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="节次"
            android:textSize="13sp"
            android:textColor="#55617A" />

        <Spinner
            android:id="@+id/ceStart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:spinnerMode="dialog"
            android:popupBackground="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:text="至"
            android:textSize="13sp"
            android:textColor="#9AA2B4" />

        <Spinner
            android:id="@+id/ceEnd"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:spinnerMode="dialog"
            android:popupBackground="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="周次"
            android:textSize="13sp"
            android:textColor="#55617A" />

        <Spinner
            android:id="@+id/ceWeeks"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:spinnerMode="dialog"
            android:popupBackground="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ceCustomRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="范围"
            android:textSize="13sp"
            android:textColor="#55617A" />

        <Spinner
            android:id="@+id/ceWeekFrom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:spinnerMode="dialog"
            android:popupBackground="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:text="至"
            android:textSize="13sp"
            android:textColor="#9AA2B4" />

        <Spinner
            android:id="@+id/ceWeekTo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:spinnerMode="dialog"
            android:popupBackground="#FFFFFF" />
    </LinearLayout>
</LinearLayout>
