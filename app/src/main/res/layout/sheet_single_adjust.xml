<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/sheet_bg"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="18dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/sheet_handle" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="单节调课"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#1B1F27" />

                    <TextView
                        android:id="@+id/singleAdjustHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="第 1 周"
                        android:textSize="11.5sp"
                        android:textColor="#9AA2B4" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/singleAdjustClose"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="-6dp"
                    android:background="@drawable/btn_icon_flat"
                    android:src="@drawable/ic_skeu_close"
                    android:tint="#8B92A3"
                    android:scaleType="centerInside"
                    android:contentDescription="关闭" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="选择课程（本周实际课表）"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#8B92A3" />

            <Spinner
                android:id="@+id/singleAdjustCourse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/cache_card_bg"
                android:paddingStart="12dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:spinnerMode="dialog"
                android:popupBackground="#FFFFFF" />

            <TextView
                android:id="@+id/singleAdjustEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/cache_card_bg"
                android:gravity="center"
                android:paddingTop="18dp"
                android:paddingBottom="18dp"
                android:text="本周这张课表上没有课"
                android:textSize="12.5sp"
                android:textColor="#9AA2B4"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="调到"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#8B92A3" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical"
                android:background="@drawable/cache_card_bg"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="星期"
                    android:textSize="12.5sp"
                    android:textColor="#55617A" />

                <Spinner
                    android:id="@+id/singleAdjustDay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:spinnerMode="dialog"
                    android:popupBackground="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="节次"
                    android:textSize="12.5sp"
                    android:textColor="#55617A" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Spinner
                        android:id="@+id/singleAdjustStart"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:spinnerMode="dialog"
                        android:popupBackground="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:text="至"
                        android:textSize="12.5sp"
                        android:textColor="#9AA2B4" />

                    <Spinner
                        android:id="@+id/singleAdjustEnd"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:spinnerMode="dialog"
                        android:popupBackground="#FFFFFF" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="教室"
                    android:textSize="12.5sp"
                    android:textColor="#55617A" />

                <EditText
                    android:id="@+id/singleAdjustRoom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="留空表示沿用原教室"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="作用范围"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#8B92A3" />

            <RadioGroup
                android:id="@+id/singleAdjustScope"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/cache_card_bg"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <RadioButton
                    android:id="@+id/singleAdjustScopeWeek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="仅这一周"
                    android:textSize="13.5sp"
                    android:textColor="#222222" />

                <RadioButton
                    android:id="@+id/singleAdjustScopeAll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="之后每周都这样（整学期改时间用这个）"
                    android:textSize="13.5sp"
                    android:textColor="#222222" />
            </RadioGroup>

            <TextView
                android:id="@+id/singleAdjustConfirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/cache_btn_primary"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="确认调课"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/singleAdjustCancel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/cache_btn_danger"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="停课（不排这节课）"
                android:textSize="13sp"
                android:textColor="#C0392B" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
