<?xml version="1.0" encoding="utf-8"?>
<!--
  保存账密对话框（自动登录用）。

  为什么改成「让用户直接输一次」而不是从登录页抓：
  教务登录页被 WebVPN 改写、DOM 随时可能重建，从页面里抓值这条链路
  在任何一环（钩子注入时机、表单重建、iframe、桥接）断掉都会静默失败，
  用户看到的就是「自动登录不生效」且查不出原因。
  由用户在本机 App 里明确输入一次，链路最短、最可控；
  密码经 Android Keystore 硬件加密后只存本机，不上传、不写日志。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="6dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="密码经手机安全芯片加密后只保存在本机，不会上传，也不写日志；随时可以清除。"
        android:textSize="12.5sp"
        android:lineSpacingExtra="2dp"
        android:textColor="#8B92A3" />

    <EditText
        android:id="@+id/credUser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="学号 / 工号"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/credPass"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:hint="统一身份认证密码"
        android:importantForAutofill="no"
        android:inputType="textPassword"
        android:maxLines="1"
        android:textSize="15sp" />
</LinearLayout>
